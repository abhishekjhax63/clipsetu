# ============================================================
# CLIPSETU — Environment Variables
# Copy this file to .env.local and fill in real values.
# ============================================================

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
APP_SECRET=change-me-to-a-long-random-string

# --- Admin allowlist (comma-separated emails) ---
# Admin access also requires a verified DB role of admin/super_admin/moderation.
# An email here alone never grants admin. Bootstrap the first Super Admin with
# BOOTSTRAP_ADMIN_SECRET (see INTEGRATION_SETUP.md).
ADMIN_EMAILS=admin@example.com

# --- Scheduled jobs ---
# Shared secret required by /api/jobs/* (metrics refresh). Send as
# `Authorization: Bearer <CRON_SECRET>`.
CRON_SECRET=

# --- Admin bootstrap ---
# One-time secret used by /api/admin/bootstrap to promote an already-authenticated,
# allowlisted user to super_admin. Set, bootstrap once, then REMOVE it.
BOOTSTRAP_ADMIN_SECRET=

# --- Email (Resend / SMTP) ---
RESEND_API_KEY=
EMAIL_FROM=noreply@clipsetu.com
SUPPORT_EMAIL=support@clipsetu.com

# --- Payments (Razorpay / Cashfree) ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- Social platform API keys ---
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
YOUTUBE_API_KEY=

# --- Error monitoring ---
SENTRY_DSN=
